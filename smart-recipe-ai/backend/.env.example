# Copy to .env and add your own key. Never commit .env.
GROQ_API_KEY=your_groq_api_key_here
# Default chat model. You can override it with another supported model from the current Groq catalogue.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=25

# Optional tuning
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PRELOAD_EMBEDDING_MODEL=true
RETRIEVAL_CANDIDATES=20

# Optional live web search for new dish requests (get a key at https://tavily.com)
TAVILY_API_KEY=
